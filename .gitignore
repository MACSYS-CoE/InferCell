# Ignore all dotfiles/dotdirs except .gitignore (also covers .DS_Store everywhere)
.*
!.gitignore
!.JuliaFormatter.toml

# Ignore root markdown except README (handoff.md / log.md are local session
# scratch — intentionally untracked).
/*.md
!README.md
!CONTRIBUTING.md

# Slurm/job logs and core dumps anywhere
*.log
core.*

# Phase 14b's per-task and per-section intermediates; the result .md files
# they are merged into are tracked
/dev/scripts/census/
/dev/scripts/validation_14b/
/dev/scripts/census_14c/
/dev/scripts/smoothing_14c/
/dev/scripts/smoothing_14c5/
/dev/scripts/decomp_14c5/
/dev/scripts/sensitivity_15/
/dev/scripts/dataset_15/
/dev/data/corea_dataset_15/*.tsv

# LaTeX build artifacts (talks/)
*.aux
*.fdb_latexmk
*.fls
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb

# examples/ for now — a clean demo will be re-added later
examples/

# Documenter build output
/docs/build/

# Non-published dev content kept out of the repo deliberately:
/dev/local-scratch-notes/

# GitHub Actions (the leading `.*` rule otherwise hides the whole tree)
!.github/
!.github/workflows/
!.github/workflows/*.yml

# OpenSpec per-change metadata records the schema a change was created under,
# so it has to travel with the change. The leading `.*` rule otherwise hides it.
# OpenSpec is retired to dev/archive/openspec/; the path moved, so this did too.
!dev/archive/openspec/**/.openspec.yaml

# Talk figures are regenerated by their plotting scripts; PNGs are tracked,
# the PDF variants are not.
dev/talks/*/figures/*.pdf
PR_REVIEW_*.md

# Python bytecode. dev/scripts/ and the figure builders under dev/notes/ are
# python, and an imported module leaves __pycache__/ beside its source.
__pycache__/
*.pyc

# Documenter resolves the docs environment fresh on every build.
docs/Manifest.toml
/dev/scripts/density_16a2_m0/
/dev/scripts/block1_16a5/
/dev/scripts/csmc_v5_16a7/
/dev/scripts/csmc_variants_16a7/
/dev/scripts/eno_path_information_16a7/
