# Ignore all dotfiles/dotdirs except .gitignore (also covers .DS_Store everywhere)
.*
!.gitignore
!.JuliaFormatter.toml

# Ignore root markdown except README (handoff.md / log.md are local session
# scratch — intentionally untracked).
/*.md
!README.md
!CONTRIBUTING.md

# Slurm/job logs and core dumps anywhere
*.log
core.*

# LaTeX build artifacts (talks/)
*.aux
*.fdb_latexmk
*.fls
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb

# examples/ for now — a clean demo will be re-added later
examples/

# MkDocs build output
/site/

# Non-published dev content kept out of the repo deliberately:
/dev/local-scratch-notes/

# GitHub Actions (the leading `.*` rule otherwise hides the whole tree)
!.github/
!.github/workflows/
!.github/workflows/*.yml

# Talk figures are regenerated by their plotting scripts; PNGs are tracked,
# the PDF variants are not.
dev/talks/*/figures/*.pdf
