# Ignore all dotfiles/dotdirs except .gitignore
.*
!.gitignore

# Ignore root markdown files except README
/*.md
!README.md

# Ignore slurm/job logs and core dumps anywhere
*.log
core.*

# Ignore examples/ for now — a clean demo will be re-added later
examples/

# Ignore everything in docs
docs/**

# But allow the directory structure
!docs/plans/
!docs/notes/
!docs/talks/
!docs/log/

# And track these specific files
!docs/plans/overview.md
!docs/plans/2026-03-13-phase1-design.md
!docs/plans/2026-04-13-v1-minimal-demo.md
!docs/notes/4D-minimal-cell.md
!docs/notes/the-case-for-inference.md
!docs/notes/spatial-dynamics-and-rdme.md

# Talks: README + shared assets at the docs/talks/ root
!docs/talks/README.md
!docs/talks/*.sty
!docs/talks/*.png
!docs/talks/figures/
!docs/talks/figures/*.png
!docs/talks/posterior_plot/
!docs/talks/posterior_plot/*.tex
!docs/talks/posterior_plot/*.pdf

# Per-talk subfolders: track .tex, .pdf, and the symlinked .sty
!docs/talks/2026-04-macsys/
!docs/talks/2026-04-macsys/talk.tex
!docs/talks/2026-04-macsys/talk.pdf
!docs/talks/2026-04-macsys/beamerthemeoxfordmaths.sty
